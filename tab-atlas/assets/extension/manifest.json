{
  "manifest_version": 3,
  "name": "TabAtlas Bridge",
  "version": "0.4.0",
  "description": "Passive local tab capture with verified duplicate cleanup and captured-tab archiving.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "alarms",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "TabAtlas Bridge",
    "default_popup": "popup.html"
  },
  "incognito": "not_allowed"
}
